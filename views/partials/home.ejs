<div class="bg-slate-50 min-h-screen py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-10">

        <!-- Hero Header Card -->
        <div
            class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-8 sm:p-12 text-center relative overflow-hidden">
            <!-- Background Ambient Glow -->
            <div class="absolute -top-24 -right-24 w-72 h-72 bg-blue-50 rounded-full blur-3xl pointer-events-none">
            </div>
            <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-indigo-50 rounded-full blur-3xl pointer-events-none">
            </div>

            <div class="relative z-10">
                <!-- Brand Badge -->
                <div
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-semibold tracking-wide uppercase mb-6">
                    <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                    SNAP Platform
                </div>

                <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                    Scalable Public Innovation Procured at <span class="text-blue-600">SNAP</span> Speed
                </h1>

                <p class="max-w-2xl mx-auto text-lg text-slate-600 leading-relaxed mb-8">
                    Define the problem, discover innovation, test it through a controlled pilot, measure the outcome,
                    and scale what works.
                </p>

                <!-- CTA Action Buttons -->
                <% if (!user) { %>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                        <a href="/auth/login"
                            class="w-full sm:w-auto inline-flex justify-center items-center px-6 py-3.5 border border-transparent text-base font-semibold rounded-xl text-white bg-blue-600 hover:bg-blue-700 transition-colors shadow-sm shadow-blue-200">
                            Login to SNAP Portal
                        </a>
                        <a href="/challenges"
                            class="w-full sm:w-auto inline-flex justify-center items-center px-6 py-3.5 border border-slate-200 text-base font-semibold rounded-xl text-slate-700 bg-white hover:bg-slate-50 transition-colors">
                            View Open Challenges
                        </a>
                    </div>
                    <% } else { %>
                        <div class="flex justify-center">
                            <% if (user.role==='GOVERNMENT' || user.role==='EVALUATOR' ) { %>
                                <a href="/government/dashboard"
                                    class="inline-flex justify-center items-center px-8 py-3.5 border border-transparent text-base font-semibold rounded-xl text-white bg-blue-600 hover:bg-blue-700 shadow-sm shadow-blue-200 transition-colors">
                                    Go to Dashboard
                                </a>
                                <% } else if (user.role==='STARTUP' ) { %>
                                    <a href="/startup/dashboard"
                                        class="inline-flex justify-center items-center px-8 py-3.5 border border-transparent text-base font-semibold rounded-xl text-white bg-blue-600 hover:bg-blue-700 shadow-sm shadow-blue-200 transition-colors">
                                        Go to Dashboard
                                    </a>
                                    <% } else if (user.role==='ADMIN' ) { %>
                                        <a href="/admin/dashboard"
                                            class="inline-flex justify-center items-center px-8 py-3.5 border border-transparent text-base font-semibold rounded-xl text-white bg-blue-600 hover:bg-blue-700 shadow-sm shadow-blue-200 transition-colors">
                                            Go to Admin Dashboard
                                        </a>
                                        <% } %>
                        </div>
                        <% } %>
            </div>
        </div>

        <!-- Live Database Metrics Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
            <div
                class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm text-center hover:border-blue-200 transition-colors">
                <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    <%= (typeof metrics !=='undefined' && metrics.usersCount) ? metrics.usersCount : 0 %>
                </div>
                <div class="text-xs sm:text-sm font-medium text-slate-500 mt-1">Platform Users</div>
            </div>

            <div
                class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm text-center hover:border-blue-200 transition-colors">
                <div class="text-3xl sm:text-4xl font-extrabold text-blue-600 tracking-tight">
                    <%= (typeof metrics !=='undefined' && metrics.challengesCount) ? metrics.challengesCount : 0 %>
                </div>
                <div class="text-xs sm:text-sm font-medium text-slate-500 mt-1">Open Challenges</div>
            </div>

            <div
                class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm text-center hover:border-blue-200 transition-colors">
                <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
                    <%= (typeof metrics !=='undefined' && metrics.pilotsCount) ? metrics.pilotsCount : 0 %>
                </div>
                <div class="text-xs sm:text-sm font-medium text-slate-500 mt-1">Active Pilots</div>
            </div>

            <div
                class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm text-center hover:border-blue-200 transition-colors">
                <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 tracking-tight">
                    <%= (typeof metrics !=='undefined' && metrics.procuredValue) ? metrics.procuredValue : '$0' %>
                </div>
                <div class="text-xs sm:text-sm font-medium text-slate-500 mt-1">Procured Value</div>
            </div>
        </div>

        <!-- Demo Credentials Section (Logged Out State) -->
        <% if (!user) { %>
            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <div class="p-2 bg-blue-50 text-blue-600 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 0121 9z">
                            </path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">SNAP Demo Credentials</h3>
                        <p class="text-xs text-slate-500">Test platform capabilities using any of these roles</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Government</div>
                        <div class="text-sm font-semibold text-slate-800 truncate">gov@demo.com</div>
                        <div class="text-xs text-slate-500 font-mono mt-1">password: <span
                                class="font-semibold text-slate-700">password</span></div>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Startup</div>
                        <div class="text-sm font-semibold text-slate-800 truncate">startup@demo.com</div>
                        <div class="text-xs text-slate-500 font-mono mt-1">password: <span
                                class="font-semibold text-slate-700">password</span></div>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Evaluator</div>
                        <div class="text-sm font-semibold text-slate-800 truncate">evaluator@demo.com</div>
                        <div class="text-xs text-slate-500 font-mono mt-1">password: <span
                                class="font-semibold text-slate-700">password</span></div>
                    </div>

                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                        <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Administrator
                        </div>
                        <div class="text-sm font-semibold text-slate-800 truncate">admin@demo.com</div>
                        <div class="text-xs text-slate-500 font-mono mt-1">password: <span
                                class="font-semibold text-slate-700">password</span></div>
                    </div>
                </div>
            </div>
            <% } %>

    </div>
</div>